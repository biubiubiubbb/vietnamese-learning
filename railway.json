{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @viet/api"
  },
  "deploy": {
    "startCommand": "npm run start -w @viet/api",
    "healthcheckPath": "/api/config",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
