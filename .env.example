# ---- API 服务（apps/api）----
PORT=8787
# 允许跨域访问的前台/后台地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 后台独立域名部署时：跨站 Cookie 需要 None + Secure
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0
# 首次启动时导入音频的源目录（默认 apps/web/public/audio/vi）
# AUDIO_SOURCE_DIR=

# ---- 前台（apps/web）----
# 独立部署时填 API 的完整地址，例如 https://api.example.com
VITE_API_BASE=

# ---- 中后台（apps/admin）----
VITE_API_BASE=
