{
  "name": "vietnamese-learning",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w @viet/api",
    "dev:web": "npm run dev -w @viet/web",
    "dev:admin": "npm run dev -w @viet/admin",
    "build": "npm run build -w @viet/api && npm run build -w @viet/web && npm run build -w @viet/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @viet/web",
    "start": "npm run start -w @viet/api",
    "audio:generate": "npm run audio:generate -w @viet/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
